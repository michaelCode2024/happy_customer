DATABASE_URL=postgres://tongyu:tongyu@localhost:5432/tongyu?sslmode=disable
DATABASE_MAX_CONNS=40
WIDGET_TOKEN_SECRET=replace-with-at-least-32-random-characters
WIDGET_TOKEN_TTL=12h
ALLOWED_ORIGIN=*
# 允许嵌套 /h5 的父页面来源（CSP frame-ancestors），交付默认 *
FRAME_ANCESTORS=*
# 单实例 WebSocket 硬顶；0 表示不限制
MAX_WS_CONNECTIONS=10000
# 会话空闲多久自动结束（分钟）。到期后按坐席「已解决」同样收尾：写 closed_at、
# 消息流留一条结束提示、计入日统计、广播 conversation.closed。0 表示不自动结束。
CONVERSATION_AUTO_CLOSE_MINUTES=30
DEMO_ENABLED=true
# 是否对公网开放 /docs 接口文档站（文档已编译进二进制，默认开启）。
# 设为 false 后匿名访问一律跳回首页；客服主管仍可在「接入管理 → 接口文档」打开，
# 服务端会为该浏览器签发一个 /docs 作用域的 12 小时 Cookie。
DOCS_ENABLED=true
# 多副本附件请改 s3，并配置 S3_* 
# STORAGE_DRIVER=local

# 首次启动初始化平台管理员；已有账号不会被环境变量覆盖
PLATFORM_ADMIN_EMAIL=admin@tongyu.local
PLATFORM_ADMIN_PASSWORD=TongYu@2026

# 大模型（可选）。不配置时 /ready 的 ai=disabled，知识库仍可检索，但不会生成 AI 回复。
# AI_PROVIDER=openai|compatible|deepseek|qwen|moonshot|custom
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_AUTO_REPLY_ENABLED=true

# Optional self-hosted WebRTC ICE servers; JSON array. No external ICE service by default.
TONGYU_RTC_ICE_SERVERS=[]
