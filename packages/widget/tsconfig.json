{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "outDir": "build/modules",
    "rootDir": "src",
    "noUncheckedIndexedAccess": true,
    "useDefineForClassFields": true
  },
  "include": ["src/**/*.ts"]
}
